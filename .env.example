NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/startupscout
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# S3-compatible object storage. Keep real access keys in an untracked .env file.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=your-startupscout-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com/startupscout-assets
S3_FORCE_PATH_STYLE=false
